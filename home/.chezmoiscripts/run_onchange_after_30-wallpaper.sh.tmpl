{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
#
# Set the desktop wallpaper to the image committed in this repo. macOS only.
# Re-runs whenever the image changes, because its hash is embedded below.
#
# wallpaper hash: {{ include "dot_config/wallpaper/current.png" | sha256sum }}

set -eu

info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }

WALLPAPER="$HOME/.config/wallpaper/current.png"

[ -f "$WALLPAPER" ] || { warn "No wallpaper at $WALLPAPER; skipping."; exit 0; }

# desktoppr is the reliable, multi-display-friendly setter. It's provided by the
# Brewfile, so if this is a first apply before brew bundle finished, we skip and
# succeed on the next apply.
if command -v desktoppr >/dev/null 2>&1; then
  info "Setting wallpaper (all displays) via desktoppr"
  desktoppr "$WALLPAPER"
elif [ -x /usr/local/bin/desktoppr ]; then
  info "Setting wallpaper via desktoppr"
  /usr/local/bin/desktoppr "$WALLPAPER"
else
  warn "desktoppr not installed yet; run 'chezmoi apply' again after brew bundle, or 'task wallpaper:set'."
  exit 0
fi

info "Wallpaper set."
{{- end -}}
