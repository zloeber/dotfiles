{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
#
# Install Homebrew (if missing) and bring the install base to parity with the
# committed Brewfile. macOS only. Re-runs automatically whenever the Brewfile
# changes, because its hash is embedded below.
#
# Brewfile hash: {{ include "dot_config/homebrew/Brewfile" | sha256sum }}

set -eu

info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }

BREWFILE="$HOME/.config/homebrew/Brewfile"

# ---------------------------------------------------------------------------
# 1. Locate or install Homebrew, then load it into this shell's environment.
# ---------------------------------------------------------------------------
if ! command -v brew >/dev/null 2>&1; then
  for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    [ -x "$candidate" ] && { eval "$("$candidate" shellenv)"; break; }
  done
fi

if ! command -v brew >/dev/null 2>&1; then
  info "Homebrew not found — installing."
  NONINTERACTIVE=1 /bin/bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    [ -x "$candidate" ] && { eval "$("$candidate" shellenv)"; break; }
  done
fi

command -v brew >/dev/null 2>&1 || { warn "Homebrew still not on PATH; aborting."; exit 1; }
info "Using brew at: $(command -v brew)"

# ---------------------------------------------------------------------------
# 2. Apply the Brewfile (formulae, casks, fonts, vscode/npm/uv globals).
# ---------------------------------------------------------------------------
if [ ! -f "$BREWFILE" ]; then
  warn "No Brewfile at $BREWFILE (has chezmoi applied it yet?); skipping."
  exit 0
fi

info "Applying Brewfile: $BREWFILE"
brew bundle --file="$BREWFILE"
info "Homebrew install base is up to date."
{{- end -}}
